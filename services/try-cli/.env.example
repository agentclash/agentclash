# Placeholders only. Load real production settings through the secret manager.
NODE_ENV=production
PORT=3001
E2B_API_KEY=<secret-manager-value>
REDIS_URL=rediss://<user>:<password>@cache.example.com:6379
REDIS_TLS_CA_FILE=/run/secrets/cache-ca.pem
TRY_CLI_GATEWAY_URL=https://terminal.example.com
TRY_CLI_CORS_ORIGINS=https://frontend.example.com
TRY_CLI_PROXY_SECRET=<at-least-32-random-bytes-from-secret-manager>
# Replace with Caddy's immediate peer address on a dedicated private network.
TRY_CLI_TRUSTED_PROXY_CIDRS=<caddy-ip>/32
TRY_CLI_MAX_CONCURRENT_SANDBOXES=40
TRY_CLI_SHUTDOWN_MS=45000
GW_ANON_MINUTES=7
GW_AUTH_MINUTES=20
GW_TRIAL_RESET_HOURS=24
GW_SESSION_BUDGET_USD=0.30
GW_DAILY_CEILING_USD=5
GW_REQUEST_RESERVE_USD=0.05
GW_REQUEST_TIMEOUT_MS=120000
GW_MAX_REQUEST_BYTES=262144
GW_MAX_OUTPUT_TOKENS=2048
GW_CODEX_MODEL=gpt-5-codex
# Optional: configure only the supported funded trials you intend to enable.
# OPENAI_API_KEY=<secret-manager-value>
# XAI_API_KEY=<secret-manager-value>
# OPENROUTER_API_KEY=<secret-manager-value>
# Claude Code and opencode are BYO-only; no operator key enters their sandboxes.
