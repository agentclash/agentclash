{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "server/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/frontend-route.test.ts"
  ]
}
