# Build context is the REPO ROOT (not backend/): the backend module depends on
# the sibling runtime module via `replace ../runtime` in backend/go.mod, so both
# module directories must be inside the build context.
#
#   docker build -f backend/Dockerfile.worker .
#
# On Railway, leave the service Root Directory unset and point Dockerfile Path
# at backend/Dockerfile.worker.

# ---- Build stage ----
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY backend/go.mod backend/go.sum backend/
COPY runtime/go.mod runtime/go.sum runtime/

WORKDIR /src/backend
RUN go mod download

COPY backend /src/backend
COPY runtime /src/runtime

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app ./cmd/worker

# Opt-in: docker build --target pdf-worker -f backend/Dockerfile.worker .
# Requires unprivileged user/network namespaces. Startup disables PDF uploads
# when the isolation self-check fails; never run this target as root/privileged.
FROM debian:bookworm-slim AS pdf-worker
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata python3 python3-venv bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home worker
COPY backend/internal/vibe/inputs/requirements.txt /tmp/pdf-requirements.txt
RUN python3 -m venv /opt/vibe-pdf-runtime \
    && /opt/vibe-pdf-runtime/bin/pip install --no-cache-dir -r /tmp/pdf-requirements.txt \
    && rm /tmp/pdf-requirements.txt
COPY --from=builder /app /app
ENV VIBE_PDF_RUNTIME=/opt/vibe-pdf-runtime
USER 10001:10001
ENTRYPOINT ["/app"]

# ---- Default runtime stage (text-only, unchanged) ----
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app /app

ENTRYPOINT ["/app"]
