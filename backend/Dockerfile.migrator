# Build from the repository root. The adjacent Dockerfile-specific ignore file
# allowlists the build context; no secrets or deployment configuration are inputs.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
WORKDIR /src
COPY backend/go.mod backend/go.sum backend/
COPY runtime/go.mod runtime/go.sum runtime/
COPY backend/cmd/db-migrate backend/cmd/db-migrate
COPY backend/internal/dbmigrate backend/internal/dbmigrate
WORKDIR /src/backend
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=readonly -trimpath -ldflags="-s -w" -o /migrator ./cmd/db-migrate

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /migrator /migrator
COPY backend/db/migrations /migrations
USER 65532:65532
ENTRYPOINT ["/migrator"]
