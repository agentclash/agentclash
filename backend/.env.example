APP_ENV=development
AUTH_MODE=dev
WORKOS_CLIENT_ID=
WORKOS_ISSUER=
API_SERVER_BIND_ADDRESS=127.0.0.1:8080
API_SHUTDOWN_TIMEOUT=30s
SSE_HEARTBEAT_INTERVAL=15s
DATABASE_URL=postgres://agentclash:agentclash@localhost:5432/agentclash?sslmode=disable
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud: supply TEMPORAL_API_KEY through the deployment secret manager.
# Its presence enables verified TLS; leave TEMPORAL_TLS_ENABLED unset.
TEMPORAL_API_KEY=
# Self-hosted mTLS: remove the API key and explicitly enable TLS. Mount each
# service's certificate/key securely; these are example paths, never real keys.
# TEMPORAL_TLS_ENABLED=true
# TEMPORAL_TLS_CA_FILE=/run/secrets/temporal/ca.pem
# TEMPORAL_TLS_SERVER_NAME=temporal
# TEMPORAL_TLS_CERT_FILE=/run/secrets/temporal/client.crt
# TEMPORAL_TLS_KEY_FILE=/run/secrets/temporal/client.key
# Outside development/dev/local/test, TLS plus API-key or mTLS auth is required.
# See docs/deployment/temporal-client.md. Restart clients after certificate rotation.
HOSTED_RUN_CALLBACK_BASE_URL=http://localhost:8080
HOSTED_RUN_CALLBACK_SECRET=agentclash-dev-hosted-callback-secret
WORKER_IDENTITY=agentclash-worker-local
# SDK grace per internal worker. Queues stop concurrently. The application
# budget must exceed twice SDK grace and leave time for activity cleanup.
WORKER_STOP_TIMEOUT=30s
WORKER_SHUTDOWN_TIMEOUT=90s
# Additional budget for destroying idle warm sandboxes after worker shutdown.
WORKER_CLEANUP_TIMEOUT=30s
REDIS_URL=redis://localhost:6379
SANDBOX_PROVIDER=unconfigured
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_API_BASE_URL=
E2B_REQUEST_TIMEOUT=30s

# --- Workspace secrets at-rest encryption ---
#
# Master key used by AES-256-GCM to encrypt workspace secrets in
# Postgres. Must be base64-encoded 32 bytes. Generate with:
#
#     openssl rand -base64 32
#
# Behavior:
#   - When APP_ENV is development/dev/local/test and this variable is
#     unset, api-server and worker generate an ephemeral per-process
#     key at boot. Secrets written during that process lifetime become
#     unreadable after restart — that is the intended dev failure mode
#     (no stale ciphertext lingering in shared state).
#   - When APP_ENV is anything else and this variable is unset, boot
#     fails loudly. Do not deploy without a persisted key.
#
# Rotation is manual in v1: to rotate, read every workspace_secrets
# row with the old key in a one-off script, re-encrypt with the new
# key, then redeploy with the new AGENTCLASH_SECRETS_MASTER_KEY. The
# ciphertext layout reserves a version byte so a future release can
# add a dual-key reader without a data migration.
#
# Where ${secrets.X} can be used (v1):
#   - Composed-tool args that delegate to the `http_request` primitive
#     (Authorization / API key headers). This is the ONLY sanctioned
#     path. Any other primitive (`exec`, `query_sql`, `submit`, etc.)
#     rejects ${secrets.X} at pack-build time with a clear error — the
#     resolved plaintext would otherwise land in /proc/[pid]/cmdline
#     or similar sandbox surfaces the evaluated agent can observe.
#   - Sandbox env_vars CANNOT carry ${secrets.X}. They must be literal
#     strings. Per-call exec in E2B doesn't inherit sandbox-level env
#     anyway, so this loses no real capability — use http_request
#     headers instead.
#
# See issue #186 for the full sandbox secret-isolation threat model
# and the hardening that makes the http_request path safe (post-exec
# request-file scrub, response header stripping, sanitized error
# paths).
AGENTCLASH_SECRETS_MASTER_KEY=

# --- Email (Resend) ---
# When set, workspace invite emails are sent via Resend.
# When unset, invites are logged but no email is sent (noop mode).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@agentclash.dev
FRONTEND_URL=http://localhost:3000

# --- Vibe Evals: disabled until an operator supplies verified values ---
# Disabled blocks new projects/quotes/inference, not authorized history,
# downloads, saving or deletion. API and worker must receive matching values.
VIBE_ENABLED=false
# API-only guest cookie signing key, supplied through the secret manager.
# Persist a cryptographically random secret of at least 32 bytes; never rotate it
# to refill/reset anonymous allowances. Do not commit real secrets.
VIBE_COOKIE_SECRET=
VIBE_OPENROUTER_KEY=
VIBE_FREE_ONLY=false
# Operator-verified model profiles (prices, limits, routes and expiry). A missing
# or expired profile makes inference unavailable. It does not stop startup.
VIBE_DEFAULT_MODEL=
VIBE_MODELS_JSON=[]
# Existing stable accounting campaign; restarting/changing DB is not new funding.
VIBE_CAMPAIGN=
VIBE_ANON_DAILY_USD=
VIBE_ANON_CAMPAIGN_USD=
# Development-only, explicitly funded paid testing; production must remain false.
VIBE_LOCAL_TESTING=false
VIBE_LOCAL_BUDGET_USD=
# New authoring always uses the current interpreted contract. Retained contracts
# 15/18/20/21 still drain immutable admitted work. The legacy VIBE_TWO_DOOR,
# VIBE_INTERPRETED_AUTHORING and JEV toggles have no effect.
# At most one funded alternative assistant per operation; never changes the
# tested agent/evaluator. Requires approved profiles and known settled costs.
VIBE_ASSISTANT_FALLBACK=true
VIBE_GROUNDED_JUDGING=true
# false blocks new material admissions; history and admitted plans remain usable.
VIBE_MATERIAL_BUILD=true
# Worker-only isolated reader root; maintained AWS worker sets its pinned path.
# Missing/failed sandbox yields pasted-text support unless PDF is release-required.
VIBE_PDF_RUNTIME=
VIBE_PDF_REQUIRED=false
# Enquiries stay unavailable until recipient/sender/delivery are configured.
VIBE_ENQUIRY_EMAIL=
VIBE_ENQUIRIES_ENABLED=false

# --- Billing (Dodo Payments) ---
# Paid checkout is disabled unless DODO_PAYMENTS_API_KEY is set.
# DODO_ENVIRONMENT selects Dodo's API host:
#   test -> https://test.dodopayments.com
#   live -> https://live.dodopayments.com
DODO_ENVIRONMENT=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
