# Repository-root build context; dedicated allowlist excludes deployment data.
ARG GO_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_IMAGE} AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY backend/go.mod backend/go.sum backend/
COPY runtime/go.mod runtime/go.sum runtime/
COPY backend/cmd backend/cmd
COPY backend/internal backend/internal
COPY runtime runtime
ARG TARGETARCH=amd64
WORKDIR /src/backend
# Compile the shared dependency graph once for the three application targets.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/ ./cmd/api-server ./cmd/worker ./cmd/db-migrate
FROM ${RUNTIME_IMAGE}
ARG TARGET=api-server
COPY --from=build /out/${TARGET} /app
COPY backend/db/migrations /migrations
# Same binary path for the dedicated migrator target, selected at build time.
RUN ln -s /app /migrator
USER 10001:10001
ENTRYPOINT ["/app"]
